# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://localhost:5432/crm

# Your login. Created (or its password updated) on every start.
APP_EMAIL=you@example.com
APP_PASSWORD=change-me
# Optional: your name, for the greeting on the to-do page
APP_NAME=

# Optional: weekday 07:30 reminder email via resend.com
RESEND_API_KEY=
DIGEST_TO=you@example.com
DIGEST_FROM=CRM <onboarding@resend.dev>
DIGEST_TIME=07:30
APP_URL=https://your-app.up.railway.app

# Optional
TIMEZONE=Europe/Amsterdam
# Optional: fixed session signing key. If unset, one is generated and stored in the database.
SESSION_SECRET=
